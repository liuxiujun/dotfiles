" =====================================================================================================
" 1. Basic
" =====================================================================================================
" 注意：IdeaVim 中 set 命令同行末尾不要写注释，否则注释内容可能被当作参数读取执行
" 显示绝对行号
set number
" 默认寄存器接入系统剪贴板，并优先使用 IDE 原生粘贴
set clipboard+=unnamed,ideaput
" 显示空白字符
set list
" 临时排查 Action ID 时再打开，平时开启会频繁弹通知
" set trackactionids
" 重构选中文本时尽量保留 Vim 的编辑体验
set idearefactormode=keep
" 在状态栏显示当前模式
set showmode
" 在状态栏显示未完成的按键序列
set showcmd
" 关闭报错时的声音提示
set visualbell
" 搜索默认忽略大小写
set ignorecase
" 搜索模式里出现大写时自动切换为大小写敏感
set smartcase
" 高亮搜索结果
set hlsearch
" 输入搜索模式时实时定位
set incsearch
" 映射等待时间，兼顾 Which-Key 和多键位映射
set timeoutlen=1000
" set ttimeoutlen=10
set keep-english-in-normal-and-restore-in-insert

" =====================================================================================================
" 2. Plugins
" =====================================================================================================
" ys/cs/ds 等成对符号操作
set surround
" 快速跳转 (<leader><leader>w / <leader><leader>b，与 Neovim hop.nvim 一致)
set easymotion
" 高亮刚复制的文本
set highlightedyank
" ae / ie 整个文件文本对象
set textobj-entire
" ai / ii 缩进块文本对象
set textobj-indent
" gcc / gc 注释
set commentary
" 文件树相关快捷键
set NERDTree
" 显示按键提示菜单
set which-key
" 在更多 IDE 输入区域启用 Vim（需安装 JetBrains Vim Everywhere 插件）
set VimEverywhere
" set peekaboo

" VimEverywhere
set ideavimsupport+=dialog
set ideavimsupport-=singleline

" =====================================================================================================
" 3. Keymaps
" =====================================================================================================
let mapleader = ","

" -------------------------
" Editor & Windows
" -------------------------
set lookupkeys-=<C-J>
set lookupkeys-=<C-K>

" imap <C-j> <Action>(EditorDown)
" imap <C-k> <Action>(EditorUp)
imap <C-j> <Down>
imap <C-k> <Up>

" 分屏窗口焦点切换（与 Neovim <C-h/j/k/l> 对齐）
nmap <C-h> <C-w>h
nmap <C-j> <C-w>j
nmap <C-k> <C-w>k
nmap <C-l> <C-w>l

" Visual 模式下缩进后保持选中状态（与 Neovim 对齐）
vnoremap < <gv
vnoremap > >gv

" -------------------------
" Config / Self
" -------------------------
" 编辑配置文件
nmap <leader>. :e ~/.ideavimrc<CR>
" 重载配置文件
nmap <leader>0 <Action>(IdeaVim.ReloadVimRc.reload)

" -------------------------
" Search / Locate (与 Neovim Telescope 对齐)
" -------------------------
" 清除搜索高亮
nmap <CR> :noh<CR>
" 找文件（对齐 Telescope <leader>ff find_files）
nmap <leader>ff <Action>(GotoFile)
" 全局文本搜索（对齐 Telescope <leader>fg live_grep）
nmap <leader>fg <Action>(FindInPath)
" 找符号/代码对象（对齐 Telescope <leader>fc）
nmap <leader>fc <Action>(GotoSymbol)
" 最近打开的文件（对齐 Telescope <leader>fr oldfiles）
nmap <leader>fr <Action>(RecentFiles)
" 全局 Search Everywhere
nmap <leader>fs <Action>(SearchEverywhere)
" 当前文件内搜索（对齐 Telescope <leader>/）
nmap <leader>/ <Action>(Find)

" -------------------------
" Buffers / Tabs
" -------------------------
" 保存
nmap <leader>s <Action>(SaveAll)
" 快速关闭当前窗口 / 所有窗口（对齐 Neovim <leader>x / <leader>X）
nmap <leader>x <Action>(CloseContent)
nmap <leader>X <Action>(CloseAllEditors)
" 关闭当前标签
nmap <leader>bd <Action>(CloseEditor)
" 关闭所有标签
nmap <leader>bD <Action>(CloseAllEditors)
" 只保留当前标签
nmap <leader>bo <Action>(CloseAllEditorsButActive)
" 切到下一个编辑器标签
nmap ]b <Action>(NextTab)
" 切到上一个编辑器标签
nmap [b <Action>(PreviousTab)

" -------------------------
" Tool Windows
" -------------------------
" 隐藏所有侧边栏
nmap <leader>h <Action>(HideSideWindows)
" Terminal 窗口
nmap <leader>t <Action>(ActivateTerminalToolWindow)
" Project 窗口
nmap <leader>e <Action>(ActivateProjectToolWindow)
" 在项目树中定位当前文件
nmap <leader>o <Action>(SelectInProjectView)
" Problems 窗口
nmap <leader>p <Action>(ActivateProblemsViewToolWindow)
" Services 窗口
nmap <leader>rs <Action>(ActivateServicesToolWindow)
" Zen mode
nmap <leader>zz <Action>(ToggleZenMode)

" -------------------------
" Code Navigation (与 Neovim 0.11 gr* 体系完全对齐)
" -------------------------
" 跳转到定义/源码
nmap gd <Action>(GotoDeclaration)
" 跳转到类型声明
nmap gD <Action>(GotoTypeDeclaration)
" 向下跳到实现类/重写方法（归还原生 gi 回到上次插入位置）
nmap gri <Action>(GotoImplementation)
" 向上跳到父类/父接口被重写的方法（与 gri 上下对称）
nmap grs <Action>(GotoSuperMethod)
" 查看完整类继承树 (Type Hierarchy)
nmap grh <Action>(TypeHierarchy)
" 跳转到变量的类型定义
nmap grt <Action>(GotoTypeDeclaration)
" 弹出悬浮引用预览框（体验对齐 Telescope grr）
nmap grr <Action>(ShowUsages)
" 在底部工具栏打开完整引用列表
nmap grR <Action>(FindUsages)
" 重命名符号（对齐 Neovim 0.11 内置 grn）
nmap grn <Action>(RenameElement)
" 快速修复 / Code Action（对齐 Neovim 0.11 内置 gra）
nmap gra <Action>(ShowIntentionActions)
vmap gra <Action>(ShowIntentionActions)
" 当前文件符号/方法大纲弹窗（对齐 Neovim 0.11 内置 gO）
nmap gO <Action>(FileStructurePopup)
" 查看悬浮文档（对齐 Neovim 内置 K）
nmap K <Action>(QuickJavaDoc)

nmap ge <Action>(GotoTest)
nmap gn <Action>(ShowNavBar)

" 跳到上一个/下一个方法（同时支持 Neovim treesitter 的 [m / ]m 与原有的 [[ / ]]）
nmap [m <Action>(MethodUp)
nmap ]m <Action>(MethodDown)
nmap [[ <Action>(MethodUp)
nmap ]] <Action>(MethodDown)

" -------------------------
" Diagnostics
" -------------------------
" 跳转到下一个错误
nmap ]d <Action>(GotoNextError)
" 跳转到上一个错误
nmap [d <Action>(GotoPreviousError)
" 显示当前错误详情
nmap gl <Action>(ShowErrorDescription)
nmap <leader>cd <Action>(ShowErrorDescription)

" -------------------------
" Code Actions
" -------------------------
imap <C-Space> <Action>(CodeCompletion)
" 优化导入
nmap <leader>co <Action>(OptimizeImports)
" 格式化代码
nmap <leader>cf <Action>(ReformatCode)
vmap <leader>cf <Action>(ReformatCode)
" 显示上下文操作/快速修复
nmap <leader>ca <Action>(ShowIntentionActions)
vmap <leader>ca <Action>(ShowIntentionActions)

vmap <leader>cs <Action>(SurroundWith)
nmap <leader>cu <Action>(Unwrap)

" -------------------------
" Generate
" -------------------------
nmap <leader>cgc <Action>(GenerateConstructor)
nmap <leader>cgl <Action>(GenerateLogField)
nmap <leader>cgg <Action>(GenerateGetterAndSetter)
nmap <leader>cge <Action>(GenerateEquals)
nmap <leader>cgo <Action>(OverrideMethods)
nmap <leader>cgi <Action>(ImplementMethods)
nmap <leader>cgd <Action>(DelegateMethods)
nmap <leader>cgt <Action>(GenerateFromTestCreatorsGroup)

" -------------------------
" Refactor
" -------------------------
" 重命名
nmap <leader>cr <Action>(RenameElement)
" 提取方法
nmap <leader>cem <Action>(ExtractMethod)
vmap <leader>cem <Action>(ExtractMethod)
" 提取变量
nmap <leader>cev <Action>(IntroduceVariable)
vmap <leader>cev <Action>(IntroduceVariable)
" 提取常量
nmap <leader>cec <Action>(ExtractConstant)
vmap <leader>cec <Action>(IntroduceConstant)
" 提取为成员变量
nmap <leader>cef <Action>(IntroduceField)
" 提取为参数
nmap <leader>cei <Action>(IntroduceParameter)

" -------------------------
" Fold
" -------------------------
" 折叠全部代码块
nmap <leader>zc <Action>(CollapseAllRegions)
" 展开全部代码块
nmap <leader>zo <Action>(ExpandAllRegions)

" -------------------------
" New / Create
" -------------------------
nmap <leader>nn <Action>(NewElement)
nmap <leader>nc <Action>(NewClass)

" -------------------------
" Run / Debug (与 Neovim nvim-dap 对齐)
" -------------------------
" 停止运行/调试
nmap <leader>rc <Action>(Stop)
" 选择运行配置并执行
nmap <leader>rr <Action>(ChooseRunConfiguration)
" 选择调试配置并执行
nmap <leader>rd <Action>(ChooseDebugConfiguration)
" 切换行断点（对齐 Neovim <leader>db）
nmap <leader>db <Action>(ToggleLineBreakpoint)
" 表达式求值（对齐 Neovim <leader>de）
nmap <leader>de <Action>(EvaluateExpression)
vmap <leader>de <Action>(EvaluateExpression)
" 打开/隐藏 Debug 窗口（对齐 Neovim <leader>du）
nmap <leader>du <Action>(ActivateDebugToolWindow)

" =====================================================================================================
" 4. Which-Key settings
" =====================================================================================================
" Which-Key 官方建议：关闭映射超时，保证提示菜单能稳定出现
set notimeout
let g:WhichKey_DefaultDelay = 0
let g:WhichKey_ShowVimActions = "true"
let g:WhichKey_SortOrder = "by_key_prefix_first"
let g:WhichKey_SortCaseSensitive = "false"

let g:WhichKeyDesc_gd = "gd Go to declaration"
let g:WhichKeyDesc_gD = "gD Go to type declaration"
let g:WhichKeyDesc_gO = "gO File structure outline"
let g:WhichKeyDesc_gr = "gr LSP Goto / Refactor"
let g:WhichKeyDesc_gri = "gri Go to implementation"
let g:WhichKeyDesc_grs = "grs Go to super method"
let g:WhichKeyDesc_grh = "grh Type hierarchy"
let g:WhichKeyDesc_grt = "grt Go to type declaration"
let g:WhichKeyDesc_grr = "grr Show usages (popup)"
let g:WhichKeyDesc_grR = "grR Find usages (tool window)"
let g:WhichKeyDesc_grn = "grn Rename symbol"
let g:WhichKeyDesc_gra = "gra Code action / Intention"
let g:WhichKeyDesc_ge = "ge Go to test"
let g:WhichKeyDesc_gn = "gn Show navigation bar"

let g:WhichKeyDesc_gl = "gl Show error description"
let g:WhichKeyDesc_prev_diag = "[d Previous diagnostic"
let g:WhichKeyDesc_next_diag = "]d Next diagnostic"
let g:WhichKeyDesc_prev_method = "[m Previous method"
let g:WhichKeyDesc_next_method = "]m Next method"
let g:WhichKeyDesc_method_up = "[[ Previous method"
let g:WhichKeyDesc_method_down = "]] Next method"

let g:WhichKeyDesc_leader = "<leader> Leader"

let g:WhichKeyDesc_dot = "<leader>. Edit IdeaVim config"
let g:WhichKeyDesc_zero = "<leader>0 Reload IdeaVim config"

let g:WhichKeyDesc_f = "<leader>f Find / Telescope"
let g:WhichKeyDesc_ff = "<leader>ff Find files"
let g:WhichKeyDesc_fg = "<leader>fg Find in path (live grep)"
let g:WhichKeyDesc_fc = "<leader>fc Find symbol"
let g:WhichKeyDesc_fr = "<leader>fr Recent files"
let g:WhichKeyDesc_fs = "<leader>fs Search everywhere"
let g:WhichKeyDesc_slash = "<leader>/ Find in current buffer"

let g:WhichKeyDesc_s = "<leader>s Save all"
let g:WhichKeyDesc_x = "<leader>x Close current editor"
let g:WhichKeyDesc_X = "<leader>X Close all editors"

let g:WhichKeyDesc_b = "<leader>b Buffers / Tabs"
