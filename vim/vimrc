" vim <目录> 启动 → 树独占布局：开树、关掉目录列表窗口（不产生 [No Name]），
" 再清理被弃置的原 buffer 避免 tabline 残留
augroup vim_nerdtree
    autocmd!
    autocmd StdinReadPre * let s:std_in=1
    autocmd VimEnter * if exists(':NERDTree') && argc() == 1 && isdirectory(argv()[0]) && !exists('s:std_in') |
        \ execute 'NERDTree' argv()[0] | wincmd p | close
        \ | execute bufnr('#') > 0 && bufnr('#') != bufnr('%') && !getbufvar(bufnr('#'), '&modified')
        \   ? 'silent! bwipeout ' . bufnr('#') : ''
        \ | execute 'cd '.argv()[0] | endif
augroup END
