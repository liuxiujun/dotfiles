if !empty(glob('~/.vim/autoload/plug.vim')) || !empty(glob('~/vimfiles/autoload/plug.vim'))
    call plug#begin()
    Plug 'easymotion/vim-easymotion'
    " j/k 加速移动（与 Neovim 同插件同参数，跨端手感一致）
    Plug 'rhysd/accelerated-jk'
    " 模糊查找：自带 C 引擎、无外部二进制依赖；C 扩展编译失败时自动回退 vimscript 模式
    Plug 'Yggdroot/LeaderF', { 'do': ':LeaderfInstallCExtension' }
    Plug 'ayu-theme/ayu-vim'
    Plug 'Yggdroot/indentLine'
    " 延迟加载：NERDTree 只在触发对应命令时载入（配置全是 g: 全局变量，加载前后行为一致）
    Plug 'preservim/nerdtree', { 'on': ['NERDTree', 'NERDTreeToggle', 'NERDTreeFind'] }
    Plug 'Xuyuanp/nerdtree-git-plugin', { 'on': ['NERDTree', 'NERDTreeToggle', 'NERDTreeFind'] }
    Plug 'vim-airline/vim-airline'
    Plug 'vim-airline/vim-airline-themes'
    Plug 'tpope/vim-commentary'
    Plug 'kana/vim-textobj-user'
    Plug 'kana/vim-textobj-entire'
    Plug 'machakann/vim-highlightedyank'
    Plug 'liuchengxu/vim-which-key'
    Plug 'tpope/vim-fugitive'
    Plug 'airblade/vim-gitgutter'
    Plug 'ryanoasis/vim-devicons'
    Plug 'tiagofumo/vim-nerdtree-syntax-highlight', { 'on': ['NERDTree', 'NERDTreeToggle', 'NERDTreeFind'] }
    call plug#end()
endif
" }}}

" ============================================================================
" Key Mappings {{{
" ============================================================================
" 退出插入模式（与 Neovim 肌肉记忆对齐）
inoremap jk <Esc>

" 取消搜索高亮（改用 <Esc> 和 <leader>nh，避免覆盖 <CR> 导致 Quickfix 列表无法回车跳转）
nnoremap <silent> <Esc> :noh<CR><Esc>
nnoremap <silent> <leader>nh :noh<CR>

" 保存与退出
nnoremap <leader>s :w<CR>
nnoremap <leader>x :q<CR>
nnoremap <leader>X :qa<CR>

" 忘记提权时强制保存（Linux 改系统配置场景）
cmap w!! w !sudo tee > /dev/null %

" Y 与 D/C 行为对齐（复制到行尾）
nnoremap Y y$

" 快速编辑与重载 vimrc
nnoremap <leader>. :e $MYVIMRC<CR>
nnoremap <leader>0 :so $MYVIMRC<CR>

" 插件管理：更新 与 移动快照锚点 刻意分开——锚点必须停在"确认过没问题"的版本，
" 组合成一键会让 :source 快照回滚到翻车版本，失去保护意义
" 更新（翻车时 :source plug-snapshot.vim 回滚）
nnoremap <silent> <leader>pu :<c-u>execute exists(':PlugUpdate') ? 'PlugUpdate' : 'echo "vim-plug 未安装"'<CR>
" 用几天确认无异常后，重新生成快照锚点（覆盖重写）
nnoremap <silent> <leader>ps :<c-u>execute exists(':PlugSnapshot') ? 'PlugSnapshot ' . fnameescape(fnamemodify($MYVIMRC, ':h') . '/plug-snapshot.vim') : 'echo "vim-plug 未安装"'<CR>

" 窗口焦点切换（与 Neovim 一致）
nnoremap <C-j> <C-W>j
nnoremap <C-k> <C-W>k
nnoremap <C-h> <C-W>h
nnoremap <C-l> <C-W>l

" 安全关闭当前 Buffer（保持分栏稳定，防止连带破坏 NERDTree 布局）
function! s:safe_buffer_delete()
    if exists('b:NERDTree') && b:NERDTree.isTabTree()
        return
    endif
    let l:curr = bufnr('%')
    let l:alt = bufnr('#')
    if buflisted(l:alt) && l:alt != l:curr
        execute 'buffer' l:alt
    else
        bnext
    endif
    if bufnr('%') != l:curr
        execute 'silent! bdelete' l:curr
    else
        execute 'silent! enew | silent! bdelete' l:curr
    endif
endfunction

" Buffer 切换与关闭（与 Neovim 对齐，在侧边栏窗口内自动保护）
nnoremap <silent> [b :if !exists('b:NERDTree') \| bprevious \| endif<CR>
nnoremap <silent> ]b :if !exists('b:NERDTree') \| bnext \| endif<CR>
nnoremap <silent> <S-h> :if !exists('b:NERDTree') \| bprevious \| endif<CR>
nnoremap <silent> <S-l> :if !exists('b:NERDTree') \| bnext \| endif<CR>
nnoremap <silent> <leader>bd :call <SID>safe_buffer_delete()<CR>
nnoremap <silent> <leader>bo :%bdelete\|edit #\|normal `"<CR>

" Quickfix 跳转（vim 中 [q/]q 非内置；配合 :grep / Leaderf rg 使用，
" 与 Neovim 侧 ]d/[d 诊断跳转的肌肉记忆一致）
nnoremap <silent> [q :cprevious<CR>
nnoremap <silent> ]q :cnext<CR>

" 内置终端映射
tnoremap <Esc> <C-\><C-n>
tnoremap jk <C-\><C-n>
nnoremap <leader>tt :botright term ++close ++rows=15<CR>
nnoremap <leader>tv :vert term ++close<CR>

" 切换相对行号
function! NumberToggle()
    if (&relativenumber == 1)
        set norelativenumber
    else
        set relativenumber number
    endif
endfunction
nnoremap <leader><Tab> :call NumberToggle()<CR>

" 文件树开关与定位（装了 NERDTree 则用 NERDTree，裸机未装插件则自动回退到内置树状 Lexplore）
nnoremap <silent> <leader>e :execute exists(':NERDTreeToggle') ? 'NERDTreeToggle' : 'Lexplore'<CR>
" 在文件树中定位当前文件（与 Neovim 的 <leader>o 对齐）
nnoremap <silent> <leader>o :execute exists(':NERDTreeFind') ? 'NERDTreeFind' : 'Lexplore'<CR>

" Git 修改块导航与操作（vim-gitgutter）
nmap <silent> <leader>hp <Plug>(GitGutterPreviewHunk)
nmap <silent> <leader>hu <Plug>(GitGutterUndoHunk)
nmap <silent> <leader>hs <Plug>(GitGutterStageHunk)
" }}}

