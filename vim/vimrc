" ============================================================================
" Basic Options {{{
" ============================================================================
set nocompatible

" Leader 键（逗号）
let mapleader = ","
let maplocalleader = " "

" 文件类型与语法高亮
filetype plugin indent on
syntax on

" 编码与换行符
set encoding=UTF-8
set fileformats=unix,dos,mac    " 打开时自动识别，优先使用 unix
set fileformat=unix             " 新建文件默认保存为 unix

" 静音提示音与闪烁
set belloff=all
set vb t_vb=

" 编辑与缩进
set backspace=indent,eol,start
set shiftwidth=4
set tabstop=4
set softtabstop=4
set expandtab
set autoindent
set smartindent

" 界面与行号（与 Neovim 对齐：默认开启相对行号，关闭晃眼的 cursorcolumn）
set number
" set relativenumber
set cursorline
set scrolloff=10
set nowrap
set showcmd
set noshowmode                    " 模式提示交给 airline，避免与状态栏重复（勿改回 showmode）
set showmatch
set signcolumn=yes
set splitbelow
set splitright
set mouse=a                       " 终端内启用鼠标定位（与 Neovim 一致）
set virtualedit=block             " 可视块编辑允许越出行尾（改配置文件的列对齐场景）
set title                         " 终端标签页显示正在编辑的文件名（wezterm 多窗格 / ssh 场景）

" 缓冲区与文件状态
set hidden                      " 允许在有未保存修改时切换 Buffer
set autoread                    " 文件在外部被修改时自动重新加载
set nobackup
set noswapfile
set history=1000

" 撤销历史持久化：文件关闭甚至 vim 退出后仍可撤销（与 Neovim 侧一致）
" undo/view 目录在 vimfiles 下，已在根 .gitignore 排除（vim/undo/、vim/view/）
set undofile
if has('win32')
    set undodir=$HOME/vimfiles/undo
    set viewdir=$HOME/vimfiles/view
else
    set undodir=$HOME/.vim/undo
    set viewdir=$HOME/.vim/view
endif
for s:state_dir in [expand(&undodir), expand(&viewdir)]
    if !isdirectory(s:state_dir) | call mkdir(s:state_dir, 'p') | endif
endfor

" 搜索设置
set incsearch
set ignorecase
set smartcase
set hlsearch

" 装了 ripgrep 就用它接管 :grep（--vimgrep 的输出直接进 quickfix；未装则保持默认，退化安全）
if executable('rg')
    set grepprg=rg\ --vimgrep
endif

" 命令行补全增强（Vim 9+ 启用纵向弹出菜单与模糊匹配）
set wildmenu
if exists('+wildoptions')
    set wildoptions=pum,fuzzy
else
    set wildmode=list:longest,full
endif
set wildignore=*.docx,*.jpg,*.png,*.gif,*.pdf,*.pyc,*.exe,*.flv,*.img,*.xlsx

" 内置语法：JSON 文件不隐藏双引号
let g:vim_json_conceal = 0
au BufNewFile,BufRead Jenkinsfile setf groovy

" 内置 netrw 文件树兜底配置（在未安装 NERDTree 的裸机上也能显示清爽树状目录）
let g:netrw_banner = 0
let g:netrw_liststyle = 3
let g:netrw_browse_split = 4
let g:netrw_altv = 1
let g:netrw_winsize = 20

" Vim 9.1+ 内置原生注释插件兜底（未安装 vim-commentary 时依然可用 gc / gcc）
if has('patch-9.1.0375')
    silent! packadd! comment
endif

" 平台差异化设置（移除在无 zsh / 无 ibus 的服务器上会报错卡顿的硬编码）
if has('win32')
    set clipboard=unnamed
    set t_Co=256
    set t_ut=
    set guifont=Consolas:h12
    set shell=cmd.exe
elseif has('unix')
    set clipboard=unnamedplus
endif
" }}}

" ============================================================================
" GUI Settings {{{
" ============================================================================
let $LANG='en'
set langmenu=en_US.UTF-8
if has("gui_running")
    if has("gui_gtk2")
        set guifont=Inconsolata\ 12
    elseif has("gui_macvim")
        set guifont=Meslo\ Regular:h14
    elseif has("gui_win32")
        set guifont=MesloLGS\ Nerd\ Font:h11
        set guifontwide=FangSong:h11
    endif
endif
