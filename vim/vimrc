" 页签配色：ayu 把 TabLine 设为 reverse 且未定义 TabLineFill/Sel（vim 默认
" Fill 也是 reverse），深色主题下会渲染成亮/白条。统一链接到状态栏配色组
augroup vim_tabline_colors
    autocmd!
    autocmd ColorScheme *
        \ highlight! link TabLine StatusLineNC
        \ | highlight! link TabLineFill StatusLineNC
        \ | highlight! link TabLineSel StatusLine
augroup END
highlight! link TabLine StatusLineNC
highlight! link TabLineFill StatusLineNC
highlight! link TabLineSel StatusLine

" 状态栏：模式 | 文件 | 修改标记 | 文件格式 | 行,列 | 百分比
set laststatus=2
set statusline=%{toupper(mode())}\ %<%f\ %h%m%r%=%{&fileformat}\ \ %-14.(%l,%c%V%)\ %P

" 顶部页签：列出全部具名 listed buffer（树/帮助等 unlisted 不出现），
" 当前项高亮、+ 表示未保存、序号即切换序
function! MyTabLine() abort
    let l:bufs = filter(range(1, bufnr('$')), 'buflisted(v:val) && !empty(bufname(v:val))')
    if empty(l:bufs) | return '' | endif
    let l:s = ''
    let l:idx = 0
    while l:idx < len(l:bufs)
        let l:nr = l:bufs[l:idx]
        let l:s .= (l:nr == bufnr('%') ? '%#TabLineSel#' : '%#TabLine#')
        let l:s .= ' ' . (l:idx + 1) . ' ' . fnamemodify(bufname(l:nr), ':t')
        \ . (getbufvar(l:nr, '&modified') ? '+' : '') . ' '
        let l:idx += 1
    endwhile
    return l:s . '%#TabLineFill#'
endfunction
set tabline=%!MyTabLine()

" 页签可见性：零具名 buffer 时（树独占启动）整行隐藏，打开文件后自动恢复。
" 本组 VimEnter 需晚于 §5 的启动链注册，故置于其后
augroup vim_tabline_visibility
    autocmd!
    autocmd VimEnter,BufEnter,BufAdd,BufDelete,BufWipeout *
        \ let &showtabline = len(filter(range(1, bufnr('$')), 'buflisted(v:val) && !empty(bufname(v:val))')) > 0 ? 2 : 0
augroup END
" }}}

