" ============================================================================
" Basic Options {{{
" ============================================================================
set nocompatible

" Leader 键与 Neovim 保持一致（空格）
let mapleader = " "
let maplocalleader = " "

" 文件类型与语法高亮
filetype plugin indent on
syntax on

" 编码与换行符
set encoding=UTF-8
set fileformats=unix,dos,mac    " 打开时自动识别，优先使用 unix
set fileformat=unix             " 新建文件默认保存为 unix

" 静音提示音与闪烁
set belloff=all
set vb t_vb=

" 编辑与缩进
set backspace=indent,eol,start
set shiftwidth=4
set tabstop=4
set softtabstop=4
set expandtab
set autoindent
set smartindent

" 界面与行号（与 Neovim 对齐：默认开启相对行号，关闭晃眼的 cursorcolumn）
set number
set relativenumber
set cursorline
set scrolloff=10
set nowrap
set showcmd
set showmode
set showmatch
set signcolumn=yes
set splitbelow
set splitright

" 缓冲区与文件状态
set hidden                      " 允许在有未保存修改时切换 Buffer
set autoread                    " 文件在外部被修改时自动重新加载
set nobackup
set noswapfile
set history=1000

" 搜索设置
set incsearch
set ignorecase
set smartcase
set hlsearch

" 命令行补全增强（Vim 9+ 启用纵向弹出菜单与模糊匹配）
set wildmenu
if exists('+wildoptions')
    set wildoptions=pum,fuzzy
else
    set wildmode=list:longest,full
endif
set wildignore=*.docx,*.jpg,*.png,*.gif,*.pdf,*.pyc,*.exe,*.flv,*.img,*.xlsx

" 内置语法：JSON 文件不隐藏双引号
let g:vim_json_conceal = 0
au BufNewFile,BufRead Jenkinsfile setf groovy

" 内置 netrw 文件树兜底配置（在未安装 NERDTree 的裸机上也能显示清爽树状目录）
let g:netrw_banner = 0
let g:netrw_liststyle = 3
let g:netrw_browse_split = 4
let g:netrw_altv = 1
let g:netrw_winsize = 20

" Vim 9.1+ 内置原生注释插件兜底（未安装 vim-commentary 时依然可用 gc / gcc）
if has('patch-9.1.0375')
    silent! packadd! comment
endif

" 平台差异化设置（移除在无 zsh / 无 ibus 的服务器上会报错卡顿的硬编码）
if has('win32')
    set clipboard=unnamed
    set t_Co=256
    set t_ut=
    set guifont=Consolas:h12
    set shell=cmd.exe
elseif has('unix')
    set clipboard=unnamedplus
endif
" }}}

" ============================================================================
" GUI Settings {{{
" ============================================================================
let $LANG='en'
set langmenu=en_US.UTF-8
if has("gui_running")
    if has("gui_gtk2")
        set guifont=Inconsolata\ 12
    elseif has("gui_macvim")
        set guifont=Meslo\ Regular:h14
    elseif has("gui_win32")
        set guifont=MesloLGS\ Nerd\ Font:h11
        set guifontwide=FangSong:h11
    endif
endif
" }}}

" ============================================================================
" Plugins (安全包裹：裸机未安装 vim-plug 时自动静默跳过，0 报错启动) {{{
" ============================================================================
if !empty(glob('~/.vim/autoload/plug.vim')) || !empty(glob('~/vimfiles/autoload/plug.vim'))
    call plug#begin()
    Plug 'easymotion/vim-easymotion'
    Plug 'ayu-theme/ayu-vim'
    Plug 'Yggdroot/indentLine'
    Plug 'preservim/nerdtree'
    Plug 'vim-airline/vim-airline'
    Plug 'tpope/vim-commentary'
    Plug 'kana/vim-textobj-user'
    Plug 'kana/vim-textobj-entire'
    Plug 'machakann/vim-highlightedyank'
    Plug 'liuchengxu/vim-which-key'
    Plug 'tpope/vim-fugitive'
    Plug 'airblade/vim-gitgutter'
    call plug#end()
endif
" }}}

" ============================================================================
" Key Mappings {{{
" ============================================================================
" 退出插入模式（与 Neovim 肌肉记忆对齐）
inoremap jk <Esc>

" 取消搜索高亮（改用 <Esc> 和 <leader>nh，避免覆盖 <CR> 导致 Quickfix 列表无法回车跳转）
nnoremap <silent> <Esc> :noh<CR><Esc>
nnoremap <silent> <leader>nh :noh<CR>

" 保存与退出
nnoremap <leader>s :w<CR>
nnoremap <leader>x :q<CR>
nnoremap <leader>X :qa<CR>

" 快速编辑与重载 vimrc
nnoremap <leader>. :e $MYVIMRC<CR>
nnoremap <leader>0 :so $MYVIMRC<CR>

" 窗口焦点切换（与 Neovim 一致）
nnoremap <C-j> <C-W>j
nnoremap <C-k> <C-W>k
nnoremap <C-h> <C-W>h
nnoremap <C-l> <C-W>l

" 标签页切换
nnoremap <A-n> :tabn<CR>
nnoremap <A-p> :tabp<CR>
nnoremap <leader>1 1gt
nnoremap <leader>2 2gt
nnoremap <leader>3 3gt
nnoremap <leader>4 4gt
nnoremap <leader>5 5gt
nnoremap <leader>6 6gt
nnoremap <leader>7 7gt
nnoremap <leader>8 8gt
nnoremap <leader>9 9gt

" 内置终端映射
tnoremap <Esc> <C-\><C-n>
tnoremap jk <C-\><C-n>
nnoremap <leader>tt :botright term ++close ++rows=15<CR>
nnoremap <leader>tv :vert term ++close<CR>

" 切换相对行号
function! NumberToggle()
    if (&relativenumber == 1)
        set norelativenumber
    else
        set relativenumber number
    endif
endfunction
nnoremap <leader><Tab> :call NumberToggle()<CR>

" 文件树开关（装了 NERDTree 则用 NERDTree，裸机未装插件则自动回退到内置树状 Lexplore）
nnoremap <silent> <leader>e :execute exists(':NERDTreeToggle') ? 'NERDTreeToggle' : 'Lexplore'<CR>
" }}}

" ============================================================================
" Plugin Configurations {{{
" ============================================================================

" --- Which-Key (仅在插件已安装时加载) ---
if exists('*which_key#register')
    set timeoutlen=500
    let g:which_key_sep = '→'
    let g:which_key_use_floating_win = 0
    let g:which_key_max_size = 0

    let g:which_key_map = {
        \ 'name' : 'Leader',
        \ '.'    : 'edit vimrc',
        \ '0'    : 'source vimrc',
        \ 'e'    : 'File Explorer',
        \ 's'    : 'Save',
        \ 'x'    : 'Close Window',
        \ 'X'    : 'Quit All',
        \ 'n'    : { 'name': '+nohl', 'h': 'Clear Search Highlight' },
        \ 't'    : { 'name': '+terminal', 't': 'Bottom Terminal', 'v': 'Vertical Terminal' },
        \ '1'    : 'Tab 1',
        \ '2'    : 'Tab 2',
        \ '3'    : 'Tab 3',
        \ '4'    : 'Tab 4',
        \ '5'    : 'Tab 5',
        \ '6'    : 'Tab 6',
        \ '7'    : 'Tab 7',
        \ '8'    : 'Tab 8',
        \ '9'    : 'Tab 9',
        \ }

    call which_key#register('<Space>', "g:which_key_map")
    nnoremap <silent> <leader> :<c-u>WhichKey '<Space>'<CR>
    vnoremap <silent> <leader> :<c-u>WhichKeyVisual '<Space>'<CR>

    augroup vim_which_key
        autocmd!
        autocmd FileType which_key set laststatus=0 noshowmode noruler
            \| autocmd BufLeave <buffer> set laststatus=2 showmode ruler
    augroup END
endif

" --- IndentLine ---
let g:indentLine_char = '┊'
let g:indentLine_first_char = '┊'
let g:indentLine_showFirstIndentLevel = 1
let g:indentLine_setColors = 0

" --- NERDTree (仅在插件存在时注册自动命令) ---
let g:NERDTreeShowHidden = 1
let g:NERDTreeAutoDeleteBuffer = 1
let g:NERDTreeDirArrows = 1
let g:NERDTreeIgnore = ['\c^ntuser\..*', '\~$']
let g:NERDTreeMinimalUI = 1

augroup vim_nerdtree
    autocmd!
    " 以目录作为参数启动 Vim 时自动打开 NERDTree
    autocmd StdinReadPre * let s:std_in=1
    autocmd VimEnter * if exists(':NERDTree') && argc() == 1 && isdirectory(argv()[0]) && !exists('s:std_in') |
        \ execute 'NERDTree' argv()[0] | wincmd p | enew | execute 'cd '.argv()[0] | endif
    " 当 NERDTree 是最后一个窗口时自动退出
    autocmd BufEnter * if winnr('$') == 1 && exists('b:NERDTree') && b:NERDTree.isTabTree() | call feedkeys(":quit\<CR>:\<BS>") | endif
augroup END
" }}}

" ============================================================================
" ColorScheme (修复加载顺序，并在未安装主题插件时自动回退内置主题) {{{
" ============================================================================
set background=dark
if has('termguicolors')
    set termguicolors
endif

let ayucolor = "dark" " 可选: "light" | "mirage" | "dark"
try
    colorscheme ayu
catch /^Vim\%((\a\+)\)\=:E185/
    silent! colorscheme habamax
endtry
" }}}

" ============================================================================
" Folding {{{
" ============================================================================
augroup filetype_vim
    autocmd!
    autocmd FileType vim setlocal foldmethod=marker
augroup END
" }}}
