    autocmd!
    " 常见配置格式 2 空格缩进（YAML 对缩进严格，社区规范也是 2 空格）
    autocmd FileType yaml,json,toml,html,css setlocal tabstop=2 shiftwidth=2 softtabstop=2
augroup END
" }}}

" ============================================================================
" View Persistence {{{
" ============================================================================
" 离开普通文件时保存视图（光标位置/折叠状态），再次打开自动恢复
augroup vim_persist_view
    autocmd!
    autocmd BufWinLeave * if &buftype ==# '' | mkview! | endif
    autocmd BufWinEnter * if &buftype ==# '' | silent! loadview | endif
augroup END
" }}}
