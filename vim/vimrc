    autocmd!
    autocmd BufNewFile,BufRead Jenkinsfile setf groovy
    " 常见配置格式 2 空格（YAML 对缩进严格，社区规范也是 2 空格）
    autocmd FileType yaml,json,toml,html,css setlocal tabstop=2 shiftwidth=2 softtabstop=2
    " vim 脚本自身按 marker 折叠
    autocmd FileType vim setlocal foldmethod=marker
augroup END

" vim 9.1+ 内置注释（gc/gcc）；更老的版本静默跳过
if has('patch-9.1.0375')
    silent! packadd! comment
endif

" 视图持久化：记住每个文件的光标位置与折叠
" viewoptions 只留 folds,cursor：默认含 options 会把 statusline 等局部选项
" 烤进 view 文件，日后换状态栏方案 loadview 会报 Unknown function
set viewoptions=folds,cursor
augroup vim_persist_view
    autocmd!
    " 无名 buffer（如 <leader>bd 的兜底空 buffer）没有 view 文件名，跳过
    autocmd BufWinLeave * if &buftype ==# '' && !exists('b:NERDTree') && bufname('') !=# '' | mkview! | endif
    autocmd BufWinEnter * if &buftype ==# '' && !exists('b:NERDTree') | silent! loadview | endif
augroup END

" 启动耗时回显：vimrc 起点 → VimEnter（含插件加载与文件树启动链）。
" 置于文件末尾使 VimEnter 晚于 §5/§6 注册，数字才是终态；只含 vimrc 之后的
" 耗时（vim 二进制自身初始化约 10-20ms 不计），细分诊断用 vim --startuptime
augroup vim_startup_time
    autocmd!
    autocmd VimEnter * echohl Comment
        \ | echo '⏱  startup ' . printf('%.0f', str2float(reltimestr(reltime(s:startup_t0))) * 1000) . 'ms'
        \ | echohl None
augroup END
" }}}
