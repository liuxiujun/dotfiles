" 3. 按键映射 {{{
" ============================================================================
" 退出插入模式（与 Neovim 肌肉记忆对齐）
inoremap jk <Esc>

" 清除搜索高亮（<Esc> 与 <leader>nh 等价；不占用 <CR>）
nnoremap <silent> <Esc> :noh<CR><Esc>
nnoremap <silent> <leader>nh :noh<CR>

" 保存与退出
nnoremap <leader>s :w<CR>
nnoremap <leader>x :q<CR>
nnoremap <leader>X :qa<CR>

" 忘记提权时强制保存（Linux 改系统配置场景）
cmap w!! w !sudo tee > /dev/null %

" Y 与 D/C 行为对齐（复制到行尾）
nnoremap Y y$

" 快速编辑与重载 vimrc
nnoremap <leader>. :e $MYVIMRC<CR>
nnoremap <leader>0 :so $MYVIMRC<CR>

" 插件更新（,pu）与快照锚点（,ps）刻意分开：锚点必须停在"确认过没问题"的
" 版本，合并成一键会让 :source 快照回滚到翻车版本。翻车回滚：vim -S plug-snapshot.vim
nnoremap <silent> <leader>pu :<c-u>execute exists(':PlugUpdate') ? 'PlugUpdate' : 'echo "vim-plug 未安装"'<CR>
nnoremap <silent> <leader>ps :<c-u>execute exists(':PlugSnapshot') ? 'PlugSnapshot ' . fnameescape(fnamemodify($MYVIMRC, ':h') . '/plug-snapshot.vim') : 'echo "vim-plug 未安装"'<CR>

" 窗口焦点切换（与 Neovim 一致）
nnoremap <C-j> <C-W>j
nnoremap <C-k> <C-W>k
nnoremap <C-h> <C-W>h
nnoremap <C-l> <C-W>l

" 安全关闭当前 Buffer（保持分栏稳定，不连带破坏文件树布局）
function! s:safe_buffer_delete()
    if exists('b:NERDTree') && b:NERDTree.isTabTree()
        return
    endif
    let l:curr = bufnr('%')
    let l:alt = bufnr('#')
    if buflisted(l:alt) && l:alt != l:curr
        execute 'buffer' l:alt
    else
        bnext
    endif
    if bufnr('%') != l:curr
        execute 'silent! bdelete' l:curr
    else
        execute 'silent! enew | silent! bdelete' l:curr
    endif
endfunction

" Buffer 切换与关闭（文件树窗口内自动保护；]b/[b 为 vim 0.11+ 内置等价键）
nnoremap <silent> [b :if !exists('b:NERDTree') \| bprevious \| endif<CR>
nnoremap <silent> ]b :if !exists('b:NERDTree') \| bnext \| endif<CR>
nnoremap <silent> <S-h> :if !exists('b:NERDTree') \| bprevious \| endif<CR>
nnoremap <silent> <S-l> :if !exists('b:NERDTree') \| bnext \| endif<CR>
nnoremap <silent> <leader>bd :call <SID>safe_buffer_delete()<CR>
nnoremap <silent> <leader>bo :%bdelete\|edit #\|normal `"<CR>

" Quickfix 跳转（vim 中 [q/]q 非内置；配合 :grep / ,fg）
nnoremap <silent> [q :cprevious<CR>
nnoremap <silent> ]q :cnext<CR>

" 跨会话回到最近编辑的文件：循环 viminfo 编号 mark '0-'9
"（nvim 靠 shada 持久化 jumplist 有同体验；'0=上次退出的文件与光标行）
let s:last_edit_idx = 0
function! s:last_edit_next() abort
    let s:last_edit_idx = s:last_edit_idx % 9 + 1
    try
        execute "normal! '" . s:last_edit_idx
        echo 'last-edited ' . s:last_edit_idx . '/9: ' . fnamemodify(@%, ':~:.')
    catch /^Vim\%((\a\+)\)\=:E20/
        echo 'last-edited: 没有更多历史了'
        let s:last_edit_idx = 0
    endtry
endfunction
nnoremap <silent> <BS> :call <SID>last_edit_next()<CR>

" 内置终端
tnoremap <Esc> <C-\><C-n>
tnoremap jk <C-\><C-n>
nnoremap <leader>tt :botright term ++close ++rows=15<CR>
nnoremap <leader>tv :vert term ++close<CR>

" 切换相对行号
function! NumberToggle()
    if (&relativenumber == 1)
        set norelativenumber
    else
        set relativenumber number
    endif
endfunction
nnoremap <leader><Tab> :call NumberToggle()<CR>

" 文件树开关与定位（裸机未装插件时回退 netrw 的 Lexplore）
nnoremap <silent> <leader>e :execute exists(':NERDTreeToggle') ? 'NERDTreeToggle' : 'Lexplore'<CR>
nnoremap <silent> <leader>o :execute exists(':NERDTreeFind') ? 'NERDTreeFind' : 'Lexplore'<CR>

" Git 修改块（vim-gitgutter）
nmap <silent> <leader>hp <Plug>(GitGutterPreviewHunk)
nmap <silent> <leader>hu <Plug>(GitGutterUndoHunk)
nmap <silent> <leader>hs <Plug>(GitGutterStageHunk)
