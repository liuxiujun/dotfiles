" 启动耗时打点：起点（终点与显示在 §7 文件末尾的 VimEnter）
let s:startup_t0 = reltime()

" ============================================================================
" 1. 基础选项 {{{
" ============================================================================
set nocompatible

let mapleader = ","
let maplocalleader = " "

" 语言环境：菜单与消息用英文，避免终端乱码
let $LANG = 'en'
set langmenu=en_US.UTF-8

" 文件类型与语法高亮
filetype plugin indent on
syntax on

" 编码与换行符
set encoding=UTF-8
set fileformats=unix,dos,mac    " 打开时自动识别，优先 unix
set fileformat=unix             " 新建文件默认 unix

set belloff=all
set vb t_vb=

" 编辑与缩进（全局 4 空格；常见配置格式在 §7 覆写为 2 空格）
set backspace=indent,eol,start
set shiftwidth=4
set tabstop=4
set softtabstop=4
set expandtab
set autoindent
set smartindent

" 界面
set number
set cursorline
set scrolloff=10
set nowrap
set showcmd
set noshowmode                    " 模式由状态栏显示（§6），关闭原生提示
set showmatch
set signcolumn=yes
set splitbelow
set splitright
set mouse=a
set virtualedit=block             " 可视块编辑允许越出行尾
set title                         " 终端标签显示文件名（wezterm/ssh 多窗格场景）

" 缓冲区与文件状态
set hidden                        " 允许带未保存修改切换 Buffer
set autoread                      " 文件被外部修改时自动重载
set nobackup
set noswapfile
set history=1000

" 撤销历史持久化（与 Neovim 一致）：退出后重开文件仍可撤销
" undo/view 目录为机器本地状态，已在根 .gitignore 排除
set undofile
if has('win32')
    set undodir=$HOME/vimfiles/undo
    set viewdir=$HOME/vimfiles/view
else
    set undodir=$HOME/.vim/undo
    set viewdir=$HOME/.vim/view
endif
for s:state_dir in [expand(&undodir), expand(&viewdir)]
    if !isdirectory(s:state_dir) | call mkdir(s:state_dir, 'p') | endif
endfor

" 搜索
set incsearch
set ignorecase
set smartcase
set hlsearch

" 装了 ripgrep 就用它接管 :grep（输出直接进 quickfix；未装保持默认）
if executable('rg')
    set grepprg=rg\ --vimgrep
endif

" 命令行补全（Vim 9+ 弹出菜单 + 模糊匹配）
set wildmenu
if exists('+wildoptions')
    set wildoptions=pum,fuzzy
else
    set wildmode=list:longest,full
endif
set wildignore=*.docx,*.jpg,*.png,*.gif,*.pdf,*.pyc,*.exe,*.flv,*.img,*.xlsx

" 平台差异只留剪贴板（字体见 §6，其余用 vim 各平台默认值）
if has('win32')
    set clipboard=unnamed
elseif has('unix')
    set clipboard=unnamedplus
endif
" }}}

" ============================================================================
" 2. 插件列表（裸机未安装 vim-plug 时整块静默跳过，0 报错启动） {{{
" ============================================================================
if !empty(glob('~/.vim/autoload/plug.vim')) || !empty(glob('~/vimfiles/autoload/plug.vim'))
    call plug#begin()
    Plug 'easymotion/vim-easymotion'
    " j/k 加速移动（与 Neovim 同插件同参数，跨端手感一致）
